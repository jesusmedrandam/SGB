NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/sgb
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_SECONDS=60
INVITATION_TOKEN_TTL_DAYS=7
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SGB
EMAIL_REQUEST_TIMEOUT_MS=10000
REFRESH_COOKIE_NAME=sgb_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
EXPOSE_AUTH_TOKENS=true
# Solo para ejecutar una vez `npm run bootstrap:superadmin --workspace @sgb/api`:
# BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@example.com
# BOOTSTRAP_SUPERADMIN_PASSWORD=una-clave-larga-y-unica
# BOOTSTRAP_SUPERADMIN_NAME=Superadministrador
